units           real

boundary        p p p

atom_style      atomic

neighbor        1.0 bin

neigh_modify    every 10 delay 0 check no

read_data		bulk-H2CO3.data

pair_style	  deepmd    20260121-500w-bulk-DT.pb

pair_coeff	  * *

velocity        all create      	298.15  	22814847

fix            dp_plm all plumed plumedfile plumed.dat outfile output.plumed

fix             1 all nvt temp 		298.15 		298.15 	1000  

timestep        1

thermo          1000

compute  myT  all  temp 

thermo_style   custom step temp   etotal   pe   

thermo_modify temp myT flush yes

dump mydump1 all custom  1000  coord.lammpstrj id type element x  y  z 

dump_modify  mydump1 element C O H sort id

restart        500000 tmp

run    10000000

write_data    Bulk-H2CO3-10ns.data

