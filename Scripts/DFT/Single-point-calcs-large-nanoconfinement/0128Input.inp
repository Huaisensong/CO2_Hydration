&GLOBAL
  PROJECT H2OAIMD
  RUN_TYPE ENERGY_FORCE
  PRINT_LEVEL MEDIUM 
&END GLOBAL

&FORCE_EVAL
  METHOD QS
  STRESS_TENSOR  DIAGONAL_ANALYTICAL
  &DFT
    BASIS_SET_FILE_NAME GTH_BASIS_SETS
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL
    &MGRID
      NGRIDS 5
      CUTOFF 1500
    &END MGRID
#    &KPOINTS
#    SCHEME MONKHORST-PACK 2 2 1
#    &END KPOINTS
    &SCF
      MAX_SCF    100
      EPS_SCF    5.0E-6
      SCF_GUESS RESTART
      ADDED_MOS 20
      &SMEAR ON
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 300
      &END SMEAR
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA   0.4
        BETA    0.5
        NBROYDEN  8
      &END
      &OUTER_SCF
        MAX_SCF 40
        EPS_SCF 5.0E-7
      &END OUTER_SCF
      &PRINT
        &RESTART
          ADD_LAST NUMERIC
          &EACH
            QS_SCF 0
          &END EACH
        &END RESTART
      &END PRINT
    &END SCF
    &QS 
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-14
    &END QS
    &XC # revPBE
      &XC_FUNCTIONAL
        &PBE 
          PARAMETRIZATION REVPBE
        &END
      &END XC_FUNCTIONAL
      &XC_GRID
        XC_DERIV SPLINE2_SMOOTH
      &END XC_GRID
      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          TYPE DFTD3
          R_CUTOFF 15
          LONG_RANGE_CORRECTION TRUE
          REFERENCE_FUNCTIONAL revPBE
          PARAMETER_FILE_NAME dftd3.dat
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A [angstrom] 24.595     0.00000000     0.00000000
      B [angstrom] 0.00000000    25.56    0.00000000
      C [angstrom] 0.00000000     0.00000000    18.3
      PERIODIC XYZ
    &END CELL
    &COORD
      @include 0128.xyz
    &END COORD
    &KIND C
        BASIS_SET DZVP-MOLOPT-SR-GTH
        POTENTIAL GTH-PBE-q4
    &END KIND
    &KIND O
        BASIS_SET TZV2P-GTH-q6
        POTENTIAL GTH-PBE-q6
    &END KIND
    &KIND H
        MASS 2.014101777
        BASIS_SET TZV2P-GTH-q1
        POTENTIAL GTH-PBE-q1
    &END KIND
  &END SUBSYS
  &PRINT
    &FORCES ON           #Print atomic forces
    &END FORCES
  &END PRINT
&END FORCE_EVAL
